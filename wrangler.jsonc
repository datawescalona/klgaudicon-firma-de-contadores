{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klgaudicon-firma-de-contadores",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build"
  }
}
